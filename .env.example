# ---------------------------------------------------------------------------
# DonorLedger — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Only config/env.js is allowed to read these values.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# --- PostgreSQL (Prisma) --------------------------------------------------
DATABASE_URL=postgresql://donorledger:password@localhost:5432/donorledger?schema=public

# --- Redis (Bull queue) ---------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Ethereum Sepolia testnet ---------------------------------------------
# Infura free tier — sign up and create a Sepolia project
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
CHAIN_ID=11155111

# --- Server-side wallets (Section 9 — two-wallet security separation) -----
# HIGHER PRIVILEGE — only loaded when Bank Islam admin endpoint is hit.
# Signs: addNGO, renewNGO, revokeNGO, approveDisbursement, rejectDisbursement,
#        unpauseCampaign, addApprovedVendor.
BANK_ISLAM_PRIVATE_KEY=0xREPLACE_ME

# LOWER PRIVILEGE — the bridge wallet, runs continuously.
# Signs: donate(), updateMilestone(), pauseCampaign() (AI auto-freeze).
SERVER_WALLET_PRIVATE_KEY=0xREPLACE_ME

# --- Deployed contract addresses (filled in after scripts/deploy.js) ------
REGISTRY_CONTRACT_ADDRESS=0x...
DONOR_TRACKER_CONTRACT_ADDRESS=0x...

# --- Donor hash salt (Section 10, Step 5) ---------------------------------
# Random secret used in SHA256(email + campaignId + timestamp + salt).
# Rotating this is irreversible — historical hashes will no longer resolve.
DONOR_HASH_SALT=replace-with-32-byte-random-hex

# --- Google Gemini --------------------------------------------------------
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-1.5-flash

# AI routing thresholds — Section 14 (never hardcode in code)
AI_REVIEW_THRESHOLD=60
AI_FREEZE_THRESHOLD=85

# --- JWT (admin auth) -----------------------------------------------------
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=12h

# --- MACC webhook ---------------------------------------------------------
# When AI auto-freeze fires, alert.service.js POSTs the full evidence
# package to this URL. For the demo this can be a mock endpoint
# (e.g. webhook.site URL) to demonstrate the integration.
MACC_WEBHOOK_URL=https://example.com/macc-mock
MACC_WEBHOOK_SECRET=replace-me

# --- File uploads ---------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# --- Demo simulation toggles ---------------------------------------------
DEMO_MODE=true
RECIPIENT_CONFIRM_DELAY_MS=5000

# --- Prisma seed (initial Bank Islam admin) ------------------------------
SEED_ADMIN_EMAIL=admin@bankislam.demo
SEED_ADMIN_PASSWORD=donorledger-demo-2026
SEED_ADMIN_NAME=Bank Islam Super Admin

# --- Optional: Etherscan API key for `hardhat verify` --------------------
ETHERSCAN_API_KEY=
