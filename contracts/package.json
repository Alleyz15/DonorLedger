{
  "name": "donorledger-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Solidity contracts for DonorLedger (Registry, Campaign, DonorTracker)",
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
